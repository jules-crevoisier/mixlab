{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mixlab",
  "version": "0.3.0",
  "identifier": "fr.mixlab.app",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mixlab",
        "width": 1600,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Logiciel DJ qui apprend à mixer",
    "longDescription": "4 platines, mixer, effets, bibliothèque, tout contrôleur MIDI et un coach qui suit le mix en direct.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
